FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app/backend/ /app/backend/
COPY ml/ /app/ml/
COPY models/ /app/models/

ENV PYTHONPATH=/app/ml:/app/backend
ENV ICDAS_MODEL_PATH=/app/models/icdas/current/deploy.keras
ENV ICDAS_DEPLOY_MODEL_PATH=/app/models/icdas/current/deploy.keras
ENV ICDAS_NUM_CLASSES=5

WORKDIR /app/backend
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
